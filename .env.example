# =============================================================================
# FoundDex Environment Variables Template
# =============================================================================
# Copy this file to `.env.local` when you are ready to connect real services:
#   cp .env.example .env.local
#
# IMPORTANT:
# - NEVER commit `.env.local` or any file containing real API keys/secrets.
# - Variables starting with `NEXT_PUBLIC_` are visible to the browser.
# - All other variables stay strictly on the server.
# - During Phase 1 (Initial Foundation), the app runs safely without real keys.
# =============================================================================

# Application URL (used for links, callbacks, and metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase (Database, Authentication, File Storage) — Needed in Phase 2+
# Find these in your Supabase Dashboard -> Project Settings -> API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# Server-only Supabase admin key (NEVER expose to browser / NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# -----------------------------------------------------------------------------
# Google Gemini API (AI-assisted matching) — Needed in Phase 4+
# Server-only key (NEVER expose to browser)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-placeholder

